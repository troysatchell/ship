# Ship Factory v2
# source: GAUNTLET/Ship — scripts/factory/*, .claude/skills/ship-{factory,pm,architect,spec,qa-review}
# generated by system-graph / to_d2.py — edit the model, not this file

direction: right

vars: {
  d2-config: {
    theme-overrides: { B1: "#f1f3f9"; N1: "#f1f3f9" }
  }
}

classes: {
  intake: {
    shape: oval
    style: {
      fill: "#1f2a41"
      stroke: "#8ab0fe"
      font-color: "#ecf0f9"
      stroke-width: 2
    }
  }
  transform: {
    shape: rectangle
    style: {
      fill: "#18301f"
      stroke: "#5fcb82"
      font-color: "#ebf3ec"
      stroke-width: 2
    }
  }
  gate: {
    shape: diamond
    style: {
      fill: "#35280d"
      stroke: "#dfa72a"
      font-color: "#f4f0e7"
      stroke-width: 2
    }
  }
  store: {
    shape: cylinder
    style: {
      fill: "#31243b"
      stroke: "#cd95f5"
      font-color: "#f3eef6"
      stroke-width: 2
    }
  }
  release: {
    shape: oval
    style: {
      fill: "#053131"
      stroke: "#0bcacc"
      font-color: "#e7f3f3"
      stroke-width: 2
    }
  }
  control: {
    shape: hexagon
    style: {
      fill: "#33353b"
      stroke: "#9fa5b0"
      font-color: "#edf0f6"
      stroke-width: 2
    }
  }
  external: {
    shape: rectangle
    style: {
      fill: "#1a1c1f"
      stroke: "#71757c"
      font-color: "#95989f"
      stroke-width: 2
      stroke-dash: 4
    }
  }
  alert: {
    shape: rectangle
    style: {
      fill: "#431d1a"
      stroke: "#fe8b7f"
      font-color: "#f8edec"
      stroke-width: 2
    }
  }
  e-flow: {
    style: {
      stroke: "#8e929b"
      stroke-width: 2
    }
  }
  e-control: {
    style: {
      stroke: "#9fa5b0"
      stroke-width: 2
      stroke-dash: 3
    }
  }
  e-data: {
    style: {
      stroke: "#0bcacc"
      stroke-width: 2
    }
  }
  e-feedback: {
    style: {
      stroke: "#dfa72a"
      stroke-width: 3
      stroke-dash: 5
    }
  }
  e-recursion: {
    style: {
      stroke: "#cd95f5"
      stroke-width: 2
      stroke-dash: 2
    }
  }
  e-violation: {
    style: {
      stroke: "#fe8b7f"
      stroke-width: 3
    }
  }
  e-gap: {
    style: {
      stroke: "#fe8b7f"
      stroke-width: 2
      stroke-dash: 6
    }
  }
}

plan: "Plan" {
  style: { stroke-dash: 3; border-radius: 12 }
  intent: "Intent\nnew capability, no audit finding behind it" { class: intake }
  audit: "Audit findings\n68 findings, each with measured evidence" { class: intake }
  spec: "PM writes the spec\n/ship-pm + /ship-spec" { class: transform }
  specgate: "Scope gate\nfive rows, any one fails the spec" { class: gate }
  architect: "Architect designs\n/ship-architect" { class: transform }
  tiering: "Tier every ticket\napply or investigate" { class: control }
  backlog: "Linear backlog\nauthoritative for ticket status" { class: store }
  survey: "Surveyor\nsonnet · answers, not source" { class: transform }
  testdesign: "Test designer\nwrites the tests before the code exists" { class: gate }
}
dispatch: "Dispatch" {
  style: { stroke-dash: 3; border-radius: 12 }
  orch: "Orchestrator\nselects, batches, serializes only on real dependencies" { class: control }
}
build: "Isolated build" {
  style: { stroke-dash: 3; border-radius: 12 }
  worktree: "Isolated worktree\nworktree.sh — own branch, own database, own ports" { class: transform }
  applier: "Applier\nhaiku · one instruction, no role brief" { class: transform }
  investigator: "Investigator\nsonnet · contract + lessons + role skill" { class: transform }
}
verify: "Verify" {
  style: { stroke-dash: 3; border-radius: 12 }
  gate: "gate.sh\ntypecheck · build · tests vs quarantine · not-weakened · regression · CHANGES · patterns" { class: gate }
  verifier: "Blind verifier\ngets the finding, the diff, the gate JSON — and nothing else" { class: gate }
  qareview: "QA reviewer\nreviews the proof — would anything have failed?" { class: gate }
}
review: "Review" {
  style: { stroke-dash: 3; border-radius: 12 }
  pr: "Pull request\nbody is the evidence, not a summary" { class: release }
  coderabbit: "CodeRabbit\nreviews the code — is it correct?" { class: external }
  pmtriage: "PM triage\nin scope? needed? efficient?" { class: control }
  merge: "Merge --no-ff\nself-closes when all five hold" { class: release }
}
observe: "Observe" {
  style: { stroke-dash: 3; border-radius: 12 }
  ledger: "Review ledger\nevery finding, every disposition" { class: store }
  state: "Derived state\nphase · lastActivityAt · idleMinutes · stalled" { class: store }
  dashboard: "Live dashboard\nSSE · localhost:7373" { class: release }
  lessons: "lessons.md\ninjected verbatim into every investigator brief" { class: store }
  newcheck: "New gate check\nreview-patterns.mjs — G7b" { class: transform }
}
escalate: "Escalate" {
  style: { stroke-dash: 3; border-radius: 12 }
  escalation: "Escalation\nparks the ticket, never the wave" { class: control }
  slack: "Slack\nthree triggers, batched" { class: external }
  rewrite: "Rewrite the ticket\nPM · max 2 attempts" { class: transform }
}

plan.intent -> plan.spec: "intent" { class: e-flow }
plan.spec -> plan.specgate: "draft spec" { class: e-flow }
plan.specgate -> plan.survey: "approved — go look" { class: e-flow }
plan.survey -> plan.architect: "what is actually there" { class: e-flow }
plan.architect -> plan.testdesign: "design" { class: e-flow }
plan.testdesign -> plan.tiering: "acceptance tests per ticket" { class: e-flow }
plan.tiering -> plan.backlog: "tiered tickets" { class: e-flow }
plan.audit -> plan.backlog: "finding carries its own spec" { class: e-flow }
plan.backlog -> dispatch.orch: "next eligible batch" { class: e-flow }
dispatch.orch -> build.worktree: "provision per ticket" { class: e-control }
build.worktree -> build.applier: "specified work" { class: e-flow }
build.worktree -> build.investigator: "cause unknown" { class: e-flow }
observe.lessons -> build.investigator: "verbatim" { class: e-data }
build.applier -> verify.gate: "diff" { class: e-flow }
build.investigator -> verify.gate: "diff + regression test" { class: e-flow }
observe.newcheck -> verify.gate: "G7b" { class: e-control }
verify.gate -> verify.verifier: "pass" { class: e-flow }
verify.verifier -> review.pr: "confirmed" { class: e-flow }
review.pr -> review.coderabbit: "reviews the code" { class: e-flow }
verify.gate -> verify.qareview: "pass — is the proof real?" { class: e-flow }
review.coderabbit -> review.pmtriage: "code findings" { class: e-flow }
verify.qareview -> review.pr: "proof holds" { class: e-flow }
review.pmtriage -> observe.ledger: "every finding" { class: e-data }
review.pmtriage -> review.merge: "all triaged" { class: e-flow }
build.worktree -> observe.state: "git + .factory-env" { class: e-data }
verify.gate -> observe.state: "gate-result.json" { class: e-data }
review.pr -> observe.state: "gh pr list" { class: e-data }
observe.state -> observe.dashboard: "SSE" { class: e-data }
plan.specgate -> plan.spec: "failed row named [spec-gate -]" { class: e-feedback }
verify.gate -> build.investigator: "exact gate output [gate-retry -]" { class: e-feedback }
verify.verifier -> build.investigator: "not-addressed — same agent [verify-retry -]" { class: e-feedback }
review.pmtriage -> build.applier: "fix now — file already named [fix-now -]" { class: e-feedback }
review.pmtriage -> plan.backlog: "real [backlog-growth +]" { class: e-feedback }
observe.ledger -> observe.lessons: "2 recurrences — a rule is missing [prompt-repair -]" { class: e-feedback }
observe.ledger -> observe.newcheck: "3+ — the prompt is not holding [mechanize -]" { class: e-feedback }
review.merge -> plan.backlog: "self-close with evidence attached [close -]" { class: e-feedback }
verify.gate -> escalate.escalation: "3 failed gates" { class: e-control }
verify.verifier -> escalate.escalation: "2 rejected verifications" { class: e-control }
escalate.escalation -> escalate.slack: "blocked · gate · summary" { class: e-flow }
escalate.escalation -> dispatch.orch: "park this ticket [park -]" { class: e-feedback }
escalate.slack -> dispatch.orch: "no defined return path for the human's answer MISSING?" { class: e-gap }
verify.verifier -> observe.ledger: "rejections bypass the recurrence thresholds MISSING?" { class: e-gap }
verify.qareview -> build.investigator: "blocks-merge — test cannot run [proof-repair -]" { class: e-feedback }
build.applier -> escalate.escalation: "instruction does not match the file" { class: e-control }
plan.architect -> plan.specgate: "no gate on the design — only the spec is reviewed MISSING?" { class: e-gap }
escalate.escalation -> escalate.rewrite: "would a rewrite succeed?" { class: e-control }
escalate.rewrite -> plan.backlog: "re-queued fresh — max 2 [rewrite -]" { class: e-feedback }
plan.architect -> plan.survey: "follow-up question [survey-followup -]" { class: e-feedback }
plan.testdesign -> plan.spec: "criterion cannot be tested — spec defect [spec-defect -]" { class: e-feedback }
plan.testdesign -> build.investigator: "the test each ticket must pass" { class: e-data }
plan.testdesign -> plan.tiering: "acceptance-tests" { class: e-data }
plan.specgate -> plan.survey: "approved-spec" { class: e-data }
observe.newcheck -> verify.gate: "check" { class: e-data }
review.coderabbit -> review.pmtriage: "code-finding" { class: e-data }
plan.architect -> plan.tiering: "design" { class: e-data }
plan.architect -> plan.testdesign: "design" { class: e-data }
build.applier -> verify.gate: "diff" { class: e-data }
build.investigator -> verify.gate: "diff" { class: e-data }
build.applier -> escalate.escalation: "discrepancy" { class: e-data }
review.pmtriage -> observe.ledger: "dismissal" { class: e-data }
dispatch.orch -> build.worktree: "dispatch" { class: e-data }
plan.spec -> plan.specgate: "draft-spec" { class: e-data }
plan.backlog -> dispatch.orch: "eligible" { class: e-data }
plan.audit -> plan.backlog: "finding" { class: e-data }
review.pmtriage -> observe.ledger: "fix-now" { class: e-data }
verify.gate -> verify.verifier: "gate-result" { class: e-data }
verify.gate -> verify.qareview: "gate-result" { class: e-data }
verify.gate -> observe.state: "gate-result" { class: e-data }
plan.intent -> plan.spec: "intent" { class: e-data }
observe.state -> observe.dashboard: "live-state" { class: e-data }
review.merge -> plan.backlog: "merged" { class: e-data }
review.pmtriage -> plan.backlog: "new-ticket" { class: e-data }
review.pmtriage -> observe.ledger: "new-ticket" { class: e-data }
escalate.escalation -> escalate.slack: "ping" { class: e-data }
review.pr -> review.coderabbit: "pr-open" { class: e-data }
review.pr -> observe.state: "pr-open" { class: e-data }
verify.qareview -> review.pr: "proof-verdict" { class: e-data }
plan.architect -> plan.survey: "question" { class: e-data }
observe.ledger -> observe.lessons: "recurrence" { class: e-data }
observe.ledger -> observe.newcheck: "recurrence" { class: e-data }
escalate.rewrite -> plan.backlog: "rewritten" { class: e-data }
observe.lessons -> build.investigator: "rule" { class: e-data }
plan.testdesign -> plan.spec: "spec-defect" { class: e-data }
verify.gate -> escalate.escalation: "stuck" { class: e-data }
verify.gate -> escalate.rewrite: "stuck" { class: e-data }
verify.verifier -> escalate.escalation: "stuck" { class: e-data }
verify.verifier -> escalate.rewrite: "stuck" { class: e-data }
escalate.escalation -> escalate.rewrite: "stuck" { class: e-data }
plan.survey -> plan.architect: "survey" { class: e-data }
plan.tiering -> plan.backlog: "ticket" { class: e-data }
verify.verifier -> review.pr: "verdict" { class: e-data }
build.worktree -> build.applier: "workspace" { class: e-data }
build.worktree -> build.investigator: "workspace" { class: e-data }
