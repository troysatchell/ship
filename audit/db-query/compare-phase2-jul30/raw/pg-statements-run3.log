	       WHERE i.workspace_id = $1
	         AND i.document_type = 'issue'
	         AND (i.properties->>'assignee_id')::uuid = $4
	         AND (s.properties->>'sprint_number')::int = $3
	         AND i.deleted_at IS NULL
	         AND s.deleted_at IS NULL
	         AND proj.deleted_at IS NULL
	     ) allocations
	     ORDER BY project_id
