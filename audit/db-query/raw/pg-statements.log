	       WHERE d.workspace_id = $1
	         AND d.document_type = 'person'
	         AND ($4 OR d.archived_at IS NULL)
	         AND (d.visibility = 'workspace' OR d.created_by = $2 OR $3 = TRUE)
	       ORDER BY d.archived_at NULLS FIRST, d.title
