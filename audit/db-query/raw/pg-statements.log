	      SELECT d.id, d.title, d.properties, d.ticket_number,
	             d.content,
	             d.created_at, d.updated_at, d.created_by,
	             d.started_at, d.completed_at, d.cancelled_at, d.reopened_at,
	             d.converted_from_id,
	             u.name as assignee_name,
