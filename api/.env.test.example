# Ship API - Local Test Database Configuration (TEST-9 / TRO-231)
#
# `pnpm test` TRUNCATEs 16 tables in the `beforeAll` of every api test file
# (see api/src/test/setup.ts). Before this fix, that ran against whatever
# `DATABASE_URL` your shell/`.env.local` resolved to — which, if you'd just
# run `pnpm dev`, was your own dev database.
#
# Copy this file to `.env.test` and point it at a dedicated, DISPOSABLE
# database you never use for anything else. NEVER your dev database (the one
# api/.env.local points at) and never a database with data you care about:
#
#   cp .env.test.example .env.test
#   createdb ship_test
#
# `api/src/db/client.ts` only loads `.env.test` when running under vitest
# (`process.env.VITEST === 'true'`, set automatically by the test runner) AND
# this file exists. If you skip this setup, `pnpm test` will NOT fall back to
# `.env.local` — it leaves DATABASE_URL to whatever your shell already has
# exported. Export one yourself (pointed at a throwaway database) if you'd
# rather not keep a `.env.test` file around.
#
# `.env.test` itself is gitignored — only this `.example` file is committed.

DATABASE_URL=postgresql://ship:ship_dev_password@localhost:5432/ship_test
