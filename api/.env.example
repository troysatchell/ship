# Ship API - Local Development Configuration
# Copy this to .env.local and customize values:
#   cp .env.example .env.local

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://ship:ship_dev_password@localhost:5432/ship_dev

# Session secret (change in production)
SESSION_SECRET=dev-only-secret-do-not-use-in-production

# CORS origin (must match frontend URL)
CORS_ORIGIN=http://localhost:5173

# Environment
NODE_ENV=development

# Server port (optional, defaults to 3000)
PORT=3000

# ====================
# Webhook signing-secret encryption (PF-302 / PLUGFORGE.MD §2.2)
# ====================
# Encrypts webhook_subscriptions.signing_secret_ciphertext at rest
# (AES-256-GCM) — a deliberate encrypt-not-hash deviation, since the server
# must recover the plaintext to compute an outgoing HMAC signature (see
# docs/architecture.md's "Documented Deviations"). Required whenever a
# request actually creates or rotates a webhook subscription; unset breaks
# only those two calls, not server boot.
# Generate a real value per environment with: openssl rand -hex 32
# SECRET_ENCRYPTION_KEY=

# ====================
# Agent chat proxy (TRO-320 / FG-9)
# ====================
# Base URL of the FleetGraph agent service. POST /api/agent/chat forwards
# here. Local dev default matches agent/.env.example's PORT=3100; production
# is the agent's Render URL (see FLEETGRAPH.MD's "Deployment model").
# AGENT_API_BASE_URL=http://localhost:3100

# Shared secret sent as the X-Internal-Secret header on every outbound call
# to the agent service above. MUST match the agent's own AGENT_INTERNAL_SECRET
# (agent/.env.example) — the agent rejects (401) any request whose header
# doesn't match, and this route refuses to call the agent at all (503) if
# this value is unset. The agent is reachable from the public internet with
# no private networking, so this is what stops an arbitrary caller from
# spending the Anthropic API budget — generate a real value per environment,
# never commit one, never reuse the dev value in production.
# AGENT_INTERNAL_SECRET=

# ====================
# PIV Authentication (Optional)
# ====================
# Configure one or both providers. If neither is configured, only password auth is available.

# FPKI Validator - Primary PIV authentication provider
# Credentials are loaded from AWS Secrets Manager at startup (preferred)
# or from environment variables (fallback)
# FPKI_ISSUER_URL=https://fpki-validator.example.gov
# FPKI_CLIENT_ID=your-client-id
# FPKI_CLIENT_SECRET=your-client-secret
# FPKI_REDIRECT_URI=http://localhost:3000/api/auth/piv/callback
# FPKI_SECRET_NAME=ship/fpki-oauth-credentials

# CAIA (Treasury Customer Authentication & Identity Architecture)
# Alternative PIV authentication provider via Treasury's CAIA
# Note: CAIA's `sub` is NOT persistent - email is the primary identifier
# CAIA_ISSUER_URL=https://caia-dev.treasury.gov
# CAIA_CLIENT_ID=your-client-id
# CAIA_CLIENT_SECRET=your-client-secret
# CAIA_REDIRECT_URI=http://localhost:3000/api/auth/caia/callback
# CAIA_SECRET_NAME=ship/caia-credentials
