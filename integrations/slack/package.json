{
  "name": "@ship/slack-integration",
  "version": "0.0.0",
  "private": true,
  "description": "Reference integration (PF-803, PLUGFORGE.MD §4): Express receiver verifying Ship webhooks (verifyWebhook) and posting document.created/issue.assigned to a Slack channel.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ship/sdk": "workspace:*"
  },
  "devDependencies": {
    "@slack/web-api": "8.0.0",
    "@types/express": "5.0.5",
    "@types/node": "22.19.5",
    "@types/supertest": "6.0.3",
    "esbuild": "0.25.12",
    "express": "4.22.1",
    "supertest": "7.2.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.17",
    "zod": "3.25.76"
  }
}
