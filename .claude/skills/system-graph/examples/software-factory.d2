intake: "Intake" {
  style: { stroke-dash: 3; border-radius: 12 }
  demand: "Demand\nCustomers, support, roadmap" { class: external }
  backlog: "Backlog\nIssue tracker" { class: intake }
  triage: "Triage & shaping\nHuman + agent pass" { class: gate }
}
build: "Build" {
  style: { stroke-dash: 3; border-radius: 12 }
  planner: "Plan synthesis\nAgent writes the plan" { class: transform }
  planreview: "Plan review\nHuman approves scope" { class: gate }
  impl: "Implementation\nAgent fleet, one ticket each" { class: transform }
  repo: "Repository\ngit, branch per ticket" { class: store }
}
verify: "Verify" {
  style: { stroke-dash: 3; border-radius: 12 }
  ci: "CI suite\nunit + integration" { class: gate }
  review: "Code review\nHuman, blocking" { class: gate }
  staging: "Staging soak\n30 min bake" { class: transform }
}
ship: "Release & operate" {
  style: { stroke-dash: 3; border-radius: 12 }
  deploy: "Deploy\nProgressive rollout" { class: control }
  prod: "Production\nServing traffic" { class: release }
  telemetry: "Telemetry\nMetrics, traces, logs" { class: store }
  incident: "Incident response\nOn-call rotation" { class: transform }
}

intake.demand -> intake.backlog: "requests" { class: e-flow }
intake.backlog -> intake.triage: "ticket" { class: e-flow }
intake.triage -> build.planner: "shaped spec" { class: e-flow }
build.planner -> build.planreview: "plan" { class: e-flow }
build.planreview -> build.impl: "approved" { class: e-flow }
build.impl -> build.repo: "branch push" { class: e-flow }
build.repo -> verify.ci: { class: e-flow }
verify.ci -> verify.review: "green" { class: e-flow }
verify.review -> verify.staging: "approved" { class: e-flow }
verify.staging -> ship.deploy: { class: e-flow }
ship.deploy -> ship.prod: { class: e-flow }
ship.prod -> ship.telemetry: "emits signal" { class: e-data }
ship.telemetry -> ship.incident: "alert fires" { class: e-control }
verify.ci -> build.impl: "tests failed [B1 -]" { class: e-feedback }
verify.review -> build.impl: "changes requested [B2 -]" { class: e-feedback }
ship.incident -> intake.backlog: "remediation work [R1 +]" { class: e-feedback }
build.planreview -> build.planner: "rescope [B3 -]" { class: e-feedback }
ship.telemetry -> intake.triage: "no signal reaches shaping MISSING?" { class: e-gap }
build.planreview -> build.impl: "approved-plan" { class: e-data }
build.impl -> build.repo: "changeset" { class: e-data }
build.planner -> build.planreview: "plan" { class: e-data }
intake.triage -> build.planner: "shaped-spec" { class: e-data }
ship.telemetry -> ship.incident: "signal" { class: e-data }
intake.backlog -> intake.triage: "ticket" { class: e-data }

__findings: "OPEN QUESTIONS\n\n[high] “Triage & shaping” is a gate with no reject path\n[high] Code review is the only unbatched human gate\n[medium] 3 stage(s) model only the happy path\n[medium] Nothing consumes “test-report”" {
  class: alert
  shape: page
  near: bottom-left
}
