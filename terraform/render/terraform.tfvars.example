# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored (see repo-root .gitignore, "TF-10" section) —
# never commit it with real values in place.
#
# render_api_key is NOT listed here on purpose: leave it out of tfvars
# entirely and export RENDER_API_KEY in your shell instead
# (`set -a; source .env; set +a`). The provider reads that env var
# automatically. Only add render_api_key below if you specifically need to
# override the environment for one run.

session_secret = "REPLACE_WITH_A_REAL_SECRET"   # e.g. output of: openssl rand -hex 32

# --- Agent service secrets (TRO-316 / FG-11) — no defaults, must be set ----
anthropic_api_key = "REPLACE_WITH_A_REAL_ANTHROPIC_API_KEY"
langsmith_api_key = "REPLACE_WITH_A_REAL_LANGSMITH_API_KEY"
ship_api_token    = "REPLACE_WITH_A_REAL_SHIP_API_TOKEN"   # a real user's Ship API token — see FLEETGRAPH.MD "Deployment model"

# --- Agent <-> api shared secret (TRO-347) — no default, must be set -------
# Shared by BOTH services (agent_service.tf and web_service.tf each read this
# same variable) — the X-Internal-Secret value api/'s agent proxy sends and
# the agent's own POST /chat / GET /inbox check before touching the graph or
# item store. The two sides MUST hold the identical value.
#
# The real value currently lives ONLY in two places, neither of them this
# repo: (1) Render's own env-var config on both the `ship` and `ship-agent`
# services (set via the Render REST API directly — the free-tier provider
# bug documented in agent_service.tf/README.md blocks a plain `terraform
# apply` against the agent service), and (2) the operator-local
# `~/.ship-agent-internal-secret` (mode 600). Generate a fresh value for any
# new environment (e.g. `openssl rand -hex 32`) — never reuse that one.
agent_internal_secret = "REPLACE_WITH_A_REAL_SHARED_SECRET"

# Everything else below has a working default in variables.tf that
# reproduces the existing live service; override only what you need to
# change.

# render_owner_id        = "tea-d9kevetg1s2s73807n5g"
# region                 = "oregon"

# service_name           = "ship"
# service_plan           = "free"
# repo_url               = "https://github.com/troysatchell/ship"
# git_branch             = "main"
# dockerfile_path        = "./Dockerfile"
# docker_context         = "."
# health_check_path      = "/health"
# cors_origin            = "https://ship-rr6m.onrender.com"

# database_service_name  = "ship-db"
# database_plan          = "free"
# database_version       = "16"
# database_name          = "ship"
# database_user          = "ship"

# agent_service_name      = "ship-agent"
# agent_service_plan      = "free"
# agent_port              = 3100
# agent_dockerfile_path   = "./agent/Dockerfile"
# agent_docker_context    = "."
# agent_health_check_path = "/health"
# langchain_project       = "fleetgraph-agent"
# langchain_endpoint      = "https://api.smith.langchain.com"

# agent_api_base_url default reproduces the current live agent's URL
# (verified 2026-08-05). Not secret, but Render assigns a NEW slug on every
# clean-machine apply that recreates the agent service — override this to
# match afterward, or api/'s calls to the agent go to a dead URL. See
# variables.tf for why this can't be derived automatically (would create a
# dependency cycle with agent_service.tf's own SHIP_API_BASE_URL).
# agent_api_base_url      = "https://ship-agent-t0zy.onrender.com"
