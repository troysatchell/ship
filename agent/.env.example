# Copy to .env.local and fill in real values. .env / .env.local / .env.*.local
# are all gitignored at the repo root — never commit real values.

# --- Server ------------------------------------------------------------------
PORT=3100

# --- Model provider: Anthropic API directly (confirmed by maintainer, TRO-313
# "the one decision still open" — NOT Bedrock; no AWS credentials have
# existed in this environment all sprint). Read only from env, never hardcode.
ANTHROPIC_API_KEY=

# --- LangSmith tracing (TRO-313 — on from the first invocation, not bolted on
# later). Both the current (LANGSMITH_*) and legacy (LANGCHAIN_*) names are
# accepted by @langchain/core; this repo's staged env uses the mix below.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=fleetgraph-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=

# --- Ship API (the agent runs under a real user's token — FLEETGRAPH.MD
# "Deployment model": there is no service account) ---------------------------
SHIP_API_BASE_URL=http://localhost:3000
SHIP_API_TOKEN=
# Connect/read timeout for outbound calls to Ship, in ms (FG-4 resilient client).
SHIP_REQUEST_TIMEOUT_MS=5000

# --- Resilient client (TRO-315 / FG-4) ---------------------------------------
# Consecutive Ship failures before the circuit breaker trips open.
SHIP_BREAKER_FAILURE_THRESHOLD=5
# How long the breaker stays open before allowing one half-open trial call, in ms.
SHIP_BREAKER_COOLDOWN_MS=30000
# Max retry attempts for idempotent (GET) Ship reads before giving up.
SHIP_RETRY_MAX_ATTEMPTS=3
# Self-throttle ceiling, requests/minute — must stay well under Ship's shared
# per-source-IP limit (~6,000 req/min), because both of Ship's own rate
# limiters fail open on a cache outage (FLEETGRAPH.MD "Reliability").
SHIP_SELF_THROTTLE_RPM=500

# --- On-demand expansion (TRO-318 / FG-7) ------------------------------------
# Hard cap on documents pulled into context per on-demand answer (counts the
# seed document itself). Required by the graph itself (OnDemandDeps.documentCap
# has no fallback in code) — this is only where a concrete number is chosen.
# "The single most important implementation constraint in the whole design"
# (FLEETGRAPH.MD's Cost Analysis: on-demand is already 64% of projected spend).
ON_DEMAND_DOCUMENT_CAP=12
